  function ReportsScreen({
    dataset,
    user,
  }: {
    dataset?: Dataset;
    user: User;
  }) {
    const metrics = sampleMetrics(dataset);
    const criticalHigh = metrics.filter((x) => x.status === "HIGH").length;
    const highestHpi = metrics.length
    ? Math.max(...metrics.map((x) => x.hpi))
    : 0;

    const exportCsv = () => {
      if (!dataset) {
        Alert.alert("Nothing to export", "Import a dataset first.");
        return;
      }

      const columns = dataset.columns || Object.keys(dataset.records?.[0] || {});
      const lines = [
        ["MetalSense metadata", "", ""],
        ["User", user.full_name, ""],
        ["Role", user.role, ""],
        ["Organization", user.organization || "", ""],
        [],
        columns,
        ...(dataset.records || []).map((row) =>
        columns.map((column) => String(row[column] ?? "")),
        ),
      ];

      const csv = lines
      .map((line: any[]) =>
      line
      .map((value) => `"${String(value ?? "").replace(/"/g, '""')}"`)
      .join(","),
      )
      .join("\n");

      if (Platform.OS === "web") {
        const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `${dataset.filename.replace(/\.[^.]+$/, "")}_metalsense.csv`;
        a.click();
        URL.revokeObjectURL(url);
      } else {
        Alert.alert("CSV ready", "CSV export is available in the web preview.");
      }
    };

    return (
      <View>
      <PageIntro
      eyebrow="EVIDENCE-READY OUTPUT"
      title="Reports & decisions"
      description="A concise, data-driven summary of your persisted dataset."
      />

      <View style={styles.panel}>
      <Text style={styles.panelTitle}>Executive summary</Text>
      <Text style={styles.panelSubtitle}>
      {dataset?.filename || "No dataset"} · Generated {new Date().toLocaleString()}
      </Text>

      <View style={styles.reportGrid}>
      <ReportCell label="CURRENT USER" value={user.full_name} />
      <ReportCell label="ROLE" value={user.role} />
      <ReportCell label="ORGANIZATION" value={user.organization || "Not provided"} />
      <ReportCell label="SAMPLES" value={String(metrics.length)} />
      <ReportCell
      label="LOCATIONS"
      value={String(
        new Set(metrics.map((x) => `${x.lat},${x.lon}`)).size,
      )}
      />
      <ReportCell label="CRITICAL / HIGH" value={String(criticalHigh)} />
      <ReportCell label="HIGHEST HPI" value={highestHpi.toFixed(2)} />
      <ReportCell label="STANDARDS" value="WHO fallback trace" />
      </View>
      </View>

      <View style={styles.panel}>
      <Text style={styles.panelTitle}>Data-driven recommendations</Text>
      <Text style={styles.panelSubtitle}>Rule-based, grounded in observed records</Text>

      <Text style={styles.recommendation}>
      • Investigate high-risk locations and collect confirmatory samples.
      </Text>
      <Text style={styles.recommendation}>
      • Review the highest-contributing metal in Pollution Analysis before remediation decisions.
      </Text>
      <Text style={styles.recommendation}>
      • Preserve the imported source file alongside this report for auditability.
      </Text>
      </View>

      <View style={styles.exportRow}>
      <Pressable style={styles.importButton} onPress={exportCsv}>
      <Ionicons name="download-outline" size={19} color="#fff" />
      <Text style={styles.importButtonText}>Export CSV</Text>
      </Pressable>
      <Text style={styles.exportHint}>
      CSV export includes MetalSense metadata and real sample rows.
      </Text>
      </View>
      </View>
    );
  }

  function ReportCell({ label, value }: { label: string; value: string }) {
    return (
