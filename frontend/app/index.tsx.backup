  function QualityScreen({ dataset }: { dataset?: Dataset }) {
    const q = dataset?.quality || {};
    const score = Math.round(q.score ?? 100);
    const total = q.total_records ?? dataset?.records?.length ?? 0;
    const valid = q.valid_records ?? total;
    const missing = q.missing_values ?? 0;
    const coordinate = q.coordinate_issues ?? 0;

    return (
      <View>
      <PageIntro
      eyebrow="VALIDATION GATE"
      title="Data quality"
      description="Quality signals are calculated from the persisted import, not estimated."
      />

      <View style={styles.qualityHero}>
      <Text style={styles.qualityEyebrow}>DATA QUALITY SCORE</Text>
      <View style={styles.qualityScoreLine}>
      <Text style={styles.qualityScore}>{score}</Text>
      <Text style={styles.qualityOutOf}>/ 100</Text>
      </View>
      <Text style={styles.qualityGrade}>
      {score >= 90 ? "Excellent" : score >= 75 ? "Good" : "Needs review"}
      </Text>
      </View>

      <View style={styles.statRow}>
      <StatCard icon="list-outline" value={total} label="Total records" />
      <StatCard icon="checkmark-circle-outline" value={valid} label="Valid records" />
      <StatCard icon="remove-circle-outline" value={missing} label="Missing values" />
      </View>

      <View style={styles.singleStat}>
      <Ionicons name="navigate-outline" size={21} color={C.teal} />
      <Text style={styles.bigStat}>{coordinate}</Text>
      <Text style={styles.statLabel}>Coordinate issues</Text>
      </View>
      </View>
    );
  }

  function AnalysisScreen({ dataset }: { dataset?: Dataset }) {
    const metrics = sampleMetrics(dataset);

    const avg = (key: "hpi" | "hei" | "cd") =>
    metrics.length
    ? metrics.reduce((sum, item) => sum + item[key], 0) / metrics.length
    : 0;

    const critical = metrics.filter((x) => x.status === "HIGH").length;

    return (
      <View>
      <PageIntro
      eyebrow="DETERMINISTIC INDICES"
      title="Pollution analysis"
      description="HPI, HEI, and Cd are calculated from measured values and configured permissible limits."
      />

      <View style={styles.statRow}>
      <MetricCard icon="pulse-outline" value={avg("hpi")} label="Average HPI" />
      <MetricCard icon="speedometer-outline" value={avg("hei")} label="Average HEI" />
      <MetricCard icon="flask-outline" value={avg("cd")} label="Average Cd" />
      </View>

      <View style={styles.singleStat}>
      <Ionicons name="alert-circle-outline" size={21} color={C.danger} />
      <Text style={styles.bigStat}>{critical}</Text>
      <Text style={styles.statLabel}>Critical</Text>
      </View>

      <View style={styles.panel}>
      <Text style={styles.panelTitle}>Sample analysis</Text>
      <Text style={styles.panelSubtitle}>
      Measured concentration, ratio, and status
      </Text>

      {metrics.length === 0 ? (
        <EmptyState
        icon="analytics-outline"
        title="No samples available"
        text="Import monitoring data to calculate indices."
        />
      ) : (
        metrics.map((item) => (
          <SampleRow
          key={item.id}
          item={item}
          standard="WHO Guidelines for Drinking-water Quality"
          />
        ))
      )}
      </View>
      </View>
    );
  }

