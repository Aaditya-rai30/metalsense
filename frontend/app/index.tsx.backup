      <ReportCell label="RESEARCH AREA" value={user.research_area || "Not provided"} />
      <View style={[styles.reportCell, { flexBasis: "100%" }]}>
      <Text style={styles.reportCellLabel}>ACCOUNT CREATED</Text>
      <Text style={styles.reportCellValue}>{prettyDate(user.created_at)}</Text>
      </View>
      </View>

      <Pressable
      style={({ pressed }) => [
        styles.signOutButton,
        pressed && { opacity: 0.7 },
      ]}
      onPress={signOut}
      >
      <Ionicons name="log-out-outline" size={18} color={C.danger} />
      <Text style={styles.signOutText}>Sign out</Text>
      </Pressable>
      </View>
      </View>
    );
  }

